# PrivaChain Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains secrets

# ===========================================
# CRITICAL SECURITY CONFIGURATION
# ===========================================

# 🔑 DEVELOPER MNEMONIC (REQUIRED)
# 24-word BIP39 seed phrase for gas sponsorship
# ⚠️ NEVER commit this to version control
# ⚠️ NEVER share this mnemonic
# ⚠️ NEVER use this mnemonic for mainnet funds
# ⚠️ This is ONLY used by the backend gas sponsorship server
# ⚠️ Frontend now uses Keplr wallet for user transactions
DEVELOPER_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# 🚨 FRONTEND VARIABLES (DEPRECATED - DO NOT USE)
# These were used in older versions but are now BLOCKED for security
# Frontend code now uses Keplr wallet extension for user keys
# The backend server uses DEVELOPER_MNEMONIC for gas sponsorship only
# VITE_DEVELOPER_MNEMONIC="" # DEPRECATED - causes runtime error if set
# VITE_COSMOS_RELAYER_MNEMONIC="" # DEPRECATED - use Keplr integration

