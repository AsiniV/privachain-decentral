import { useState, useEffect } from 'react'
import { useKV } from '@github/spark/hooks'
import { Button } from './ui/button'
import { Input } from './ui/input'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from './ui/card'
import { Badge } from './ui/badge'
import { Avatar, AvatarFallback } from './ui/avatar'
import { Tabs, TabsContent, TabsList, TabsTrigger } from './ui/tabs'
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from './ui/dialog'
import { Switch } from './ui/switch'
import { Progress } from './ui/progress'
import { Label } from './ui/label'
import { Separator } from './ui/separator'
import { BlockchainStatus } from './BlockchainStatus'
import { GasFeeStatus } from './GasFeeStatus'
import { WalletManager } from './WalletManager'
import { IPFSIntegrationDemo } from './IPFSIntegrationDemo'
import { PaymentView } from './PaymentView'
import { 
  User,
  Shield,
  Key,
  Wallet,
  Crown,
  Copy,
  Check,
  QrCode,
  Lock,
  Globe,
  Star,
  CreditCard,
  Bank,
  Settings,
  Bell,
  Eye,
  Download,
  Coins,
  CloudArrowUp
} from '@phosphor-icons/react'
import { paymentService } from '../services/PaymentService'
import { cn } from '../lib/utils'
import { toast } from 'sonner'

interface UserProfile {
  address: string
  displayName: string
  email: string
  prvDomain: string
  joinDate: number
  isPremium: boolean
  reputation: number
  publicKey: string
  tier: 'free' | 'premium' | 'enterprise'
  messageCount: number
  storageUsed: number
  gasUsed: number
  privBalance: number
  paymentMethod: 'traditional' | 'crypto' | 'hybrid'
  sponsoredGasRemaining: number
}

interface UserPreferences {
  notifications: boolean
  anonymousMode: boolean
  metadataProtection: boolean
  autoDeleteMessages: boolean
  biometricAuth: boolean
  preferCryptoPayments: boolean
}

export function ProfileView() {
  const [profile, setProfile] = useKV<UserProfile>('user-profile', {
    address: 'priv1x7k9m2n8q5r3t6u9v2w5y8z1a4b7c0d3e6f9',
    displayName: 'Alice Chen',
    email: 'alice@protonmail.com',
    prvDomain: 'alice.prv',
    joinDate: Date.now() - 2592000000, // 30 days ago
    isPremium: false,
    tier: 'free',
    reputation: 847,
    publicKey: 'priv_pk_1x7k9m2n8q5r3t6u9v2w5y8z1a4b7c0d3e6f9g2h5i8',
    messageCount: 2847,
    storageUsed: 12.5, // GB
    gasUsed: 156.8, // PRIV tokens
    privBalance: 1250.0,
    paymentMethod: 'traditional',
    sponsoredGasRemaining: 45000 // Monthly quota
  })
  
  const [preferences, setPreferences] = useKV<UserPreferences>('user-preferences', {
    notifications: true,
    anonymousMode: false,
    metadataProtection: true,
    autoDeleteMessages: false,
    biometricAuth: true,
    preferCryptoPayments: false
  })

  const [walletInfo] = useKV('wallet-info', {
    balance: '1,250.5',
    staked: '500.0',
    earned: '12.3'
  })

  const [activeTab, setActiveTab] = useState<'profile' | 'billing' | 'privacy' | 'security' | 'ipfs'>('profile')
  const [copied, setCopied] = useState('')
  const [showPaymentView, setShowPaymentView] = useState(false)
  const [premiumStatus, setPremiumStatus] = useState<any>(null)

  const copyToClipboard = async (text: string, type: string) => {
    await navigator.clipboard.writeText(text)
    setCopied(type)
    toast.success(`${type} copied to clipboard`)
    setTimeout(() => setCopied(''), 2000)
  }

  const handleUpgrade = () => {
    setShowPaymentView(true)
  }

  const handlePaymentMethodChange = (method: 'traditional' | 'crypto' | 'hybrid') => {
    setProfile(prev => ({ ...prev, paymentMethod: method }))
    toast.success(`Payment method changed to ${method}`)
  }

  // Load premium status on component mount
  useEffect(() => {
    const loadPremiumStatus = async () => {
      const status = await paymentService.getPremiumStatus()
      setPremiumStatus(status)
      if (status.isPremium) {
        setProfile(prev => ({ ...prev, isPremium: true, tier: 'premium' }))
      }
    }
    loadPremiumStatus()
  }, [setProfile])
  }

  const updatePreference = (key: keyof UserPreferences, value: boolean) => {
    setPreferences(prev => ({ ...prev, [key]: value }))
    toast.success('Preference updated')
  }

  const formatDate = (timestamp: number) => {
    return new Date(timestamp).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  }

  const getTierColor = (tier: string) => {
    switch (tier) {
      case 'premium': return 'text-primary'
      case 'enterprise': return 'text-accent'
      default: return 'text-muted-foreground'
    }
  }

  const getTierIcon = (tier: string) => {
    switch (tier) {
      case 'premium': return <Crown className="w-4 h-4" />
      case 'enterprise': return <Star className="w-4 h-4" />
      default: return <User className="w-4 h-4" />
    }
  }

  return (
    <div className="flex flex-col h-full">
      {/* Header */}
      <div className="p-6 border-b border-border bg-card">
        <div className="flex items-center gap-4 mb-6">
          <Avatar className="w-16 h-16">
            <AvatarFallback className="text-2xl">
              {profile.displayName.split(' ').map(n => n[0]).join('')}
            </AvatarFallback>
          </Avatar>
          <div className="flex-1">
            <div className="flex items-center gap-2 mb-1">
              <h1 className="text-2xl font-bold">{profile.displayName}</h1>
              <Badge className={cn("gap-1", getTierColor(profile.tier))}>
                {getTierIcon(profile.tier)}
                {profile.tier.toUpperCase()}
              </Badge>
            </div>
            <p className="text-muted-foreground">{profile.email}</p>
            <p className="text-sm text-muted-foreground">
              Member since {formatDate(profile.joinDate)}
            </p>
          </div>
        </div>
        
        {/* Quick Stats */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <Card>
            <CardContent className="p-4">
              <div className="flex items-center gap-2">
                <Coins className="w-5 h-5 text-primary" />
                <div>
                  <p className="text-sm text-muted-foreground">PRIV Balance</p>
                  <p className="text-lg font-semibold">{profile.privBalance.toLocaleString()}</p>
                </div>
              </div>
            </CardContent>
          </Card>
          
          <Card>
            <CardContent className="p-4">
              <div className="flex items-center gap-2">
                <Globe className="w-5 h-5 text-accent" />
                <div>
                  <p className="text-sm text-muted-foreground">Messages Sent</p>
                  <p className="text-lg font-semibold">{profile.messageCount.toLocaleString()}</p>
                </div>
              </div>
            </CardContent>
          </Card>
          
          <Card>
            <CardContent className="p-4">
              <div className="flex items-center gap-2">
                <Shield className="w-5 h-5 text-green-500" />
                <div>
                  <p className="text-sm text-muted-foreground">Privacy Score</p>
                  <p className="text-lg font-semibold">{profile.reputation}</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>

      {/* Tabs */}
      <div className="flex-1 p-6">
        <Tabs value={activeTab} onValueChange={(v) => setActiveTab(v as any)} className="w-full">
          <TabsList className="grid w-full grid-cols-5">
            <TabsTrigger value="profile">Profile</TabsTrigger>
            <TabsTrigger value="billing">Billing</TabsTrigger>
            <TabsTrigger value="privacy">Privacy</TabsTrigger>
            <TabsTrigger value="security">Security</TabsTrigger>
            <TabsTrigger value="ipfs">IPFS Demo</TabsTrigger>
          </TabsList>

          {/* Profile Tab */}
          <TabsContent value="profile" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <User className="w-5 h-5" />
                  Account Information
                </CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <Label>Display Name</Label>
                    <Input value={profile.displayName} readOnly />
                  </div>
                  <div>
                    <Label>Email Address</Label>
                    <Input value={profile.email} readOnly />
                  </div>
                </div>
                
                <div>
                  <Label>PrivaChain Address (@{profile.prvDomain})</Label>
                  <div className="flex gap-2">
                    <Input value={profile.prvDomain} readOnly />
                    <Button
                      variant="outline"
                      size="icon"
                      onClick={() => copyToClipboard(profile.prvDomain, 'Domain')}
                    >
                      {copied === 'Domain' ? <Check className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                    </Button>
                  </div>
                </div>
                
                <div>
                  <Label>Blockchain Address</Label>
                  <div className="flex gap-2">
                    <Input value={profile.address} readOnly className="font-mono text-xs" />
                    <Button
                      variant="outline"
                      size="icon"
                      onClick={() => copyToClipboard(profile.address, 'Address')}
                    >
                      {copied === 'Address' ? <Check className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                    </Button>
                  </div>
                </div>

                <div className="flex gap-2">
                  <Button>Edit Profile</Button>
                  <Button variant="outline">Export Data</Button>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Billing Tab */}
          <TabsContent value="billing" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <CreditCard className="w-5 h-5" />
                  Subscription & Billing
                </CardTitle>
                <CardDescription>
                  Manage your subscription and payment methods
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-6">
                {/* Current Plan */}
                <div className="p-4 border rounded-lg">
                  <div className="flex items-center justify-between mb-2">
                    <h3 className="font-semibold">Current Plan: {profile.tier.toUpperCase()}</h3>
                    <Badge className={getTierColor(profile.tier)}>
                      {getTierIcon(profile.tier)} {premiumStatus?.isPremium ? 'Active' : 'Free'}
                    </Badge>
                  </div>
                  <p className="text-sm text-muted-foreground mb-4">
                    {premiumStatus?.isPremium 
                      ? `Premium Plan - Expires ${premiumStatus.expiresAt ? new Date(premiumStatus.expiresAt).toLocaleDateString() : 'Never'}`
                      : 'Free plan with basic features'
                    }
                  </p>
                  
                  {premiumStatus?.isPremium ? (
                    <div className="space-y-4">
                      <div>
                        <h4 className="font-medium mb-2">Premium Features</h4>
                        <div className="grid grid-cols-2 gap-2 text-sm">
                          {premiumStatus.features?.map((feature: string, index: number) => (
                            <div key={index} className="flex items-center gap-2">
                              <Check className="w-4 h-4 text-accent" />
                              <span>{feature}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                      
                      <div className="p-3 bg-accent/10 border border-accent/20 rounded-lg">
                        <div className="flex items-center gap-2 text-accent">
                          <Crown className="w-4 h-4" />
                          <span className="font-medium">Premium Active</span>
                        </div>
                        <p className="text-sm text-muted-foreground mt-1">
                          Enjoy enhanced privacy and unlimited features
                        </p>
                      </div>
                    </div>
                  ) : (
                    <div className="space-y-4">
                      <div>
                        <h4 className="font-medium mb-2">Free Plan Features</h4>
                        <div className="space-y-2 text-sm">
                          <div className="flex items-center gap-2">
                            <Check className="w-4 h-4 text-muted-foreground" />
                            <span>Basic messaging</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <Check className="w-4 h-4 text-muted-foreground" />
                            <span>1GB mail storage</span>
                          </div>
                          <div className="flex items-center gap-2">
                            <Check className="w-4 h-4 text-muted-foreground" />
                            <span>Group chats up to 50 users</span>
                          </div>
                        </div>
                      </div>
                      
                      <Button onClick={handleUpgrade} className="w-full">
                        <Crown className="w-4 h-4 mr-2" />
                        Upgrade to Premium
                      </Button>
                    </div>
                  )}
                </div>

                {/* Payment Method Selection */}
                <div>
                  <h3 className="font-semibold mb-4">Payment Method Preferences</h3>
                  <div className="space-y-3">
                    <div className="flex items-center justify-between p-3 border rounded-lg">
                      <div className="flex items-center gap-3">
                        <CreditCard className="w-5 h-5" />
                        <div>
                          <p className="font-medium">Traditional Payment</p>
                          <p className="text-sm text-muted-foreground">Credit cards, bank transfers (fastest setup)</p>
                        </div>
                      </div>
                      <Switch 
                        checked={profile.paymentMethod === 'traditional'} 
                        onCheckedChange={() => handlePaymentMethodChange('traditional')}
                      />
                    </div>
                    
                    <div className="flex items-center justify-between p-3 border rounded-lg">
                      <div className="flex items-center gap-3">
                        <Wallet className="w-5 h-5" />
                        <div>
                          <p className="font-medium">Cryptocurrency</p>
                          <p className="text-sm text-muted-foreground">Anonymous payments with XMR, BTC, ETH, USDT, ZEC</p>
                        </div>
                      </div>
                      <Switch 
                        checked={profile.paymentMethod === 'crypto'} 
                        onCheckedChange={() => handlePaymentMethodChange('crypto')}
                      />
                    </div>
                    
                    <div className="flex items-center justify-between p-3 border rounded-lg">
                      <div className="flex items-center gap-3">
                        <Bank className="w-5 h-5" />
                        <div>
                          <p className="font-medium">Hybrid Payment</p>
                          <p className="text-sm text-muted-foreground">Both traditional and crypto options</p>
                        </div>
                      </div>
                      <Switch 
                        checked={profile.paymentMethod === 'hybrid'} 
                        onCheckedChange={() => handlePaymentMethodChange('hybrid')}
                      />
                    </div>
                  </div>
                </div>

                {/* Gas Usage */}
                <div>
                  <h3 className="font-semibold mb-4">Cosmos Network Gas (Developer Sponsored)</h3>
                  <div className="space-y-2">
                    <div className="flex justify-between text-sm">
                      <span>Monthly Quota Used</span>
                      <span>{((50000 - profile.sponsoredGasRemaining) / 50000 * 100).toFixed(1)}%</span>
                    </div>
                    <Progress value={(50000 - profile.sponsoredGasRemaining) / 50000 * 100} />
                    <p className="text-xs text-muted-foreground">
                      {profile.sponsoredGasRemaining.toLocaleString()} ATOM operations remaining this month
                    </p>
                    <div className="p-3 bg-blue-50 border border-blue-200 rounded-lg">
                      <div className="flex items-center gap-2 text-blue-800">
                        <Shield className="w-4 h-4" />
                        <span className="font-medium">Sponsored Gas Fees</span>
                      </div>
                      <p className="text-sm text-blue-700 mt-1">
                        Gas fees are paid by the developer's wallet to maintain user anonymity
                      </p>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Privacy Tab */}
          <TabsContent value="privacy" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Eye className="w-5 h-5" />
                  Privacy Settings
                </CardTitle>
                <CardDescription>
                  Control your privacy and anonymity preferences
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Anonymous Mode</p>
                    <p className="text-sm text-muted-foreground">Hide your identity from message recipients</p>
                  </div>
                  <Switch 
                    checked={preferences.anonymousMode}
                    onCheckedChange={(value) => updatePreference('anonymousMode', value)}
                  />
                </div>
                
                <Separator />
                
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Metadata Protection</p>
                    <p className="text-sm text-muted-foreground">Advanced traffic analysis resistance</p>
                  </div>
                  <Switch 
                    checked={preferences.metadataProtection}
                    onCheckedChange={(value) => updatePreference('metadataProtection', value)}
                  />
                </div>
                
                <Separator />
                
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Auto-Delete Messages</p>
                    <p className="text-sm text-muted-foreground">Automatically delete messages after 24 hours</p>
                  </div>
                  <Switch 
                    checked={preferences.autoDeleteMessages}
                    onCheckedChange={(value) => updatePreference('autoDeleteMessages', value)}
                  />
                </div>
                
                <Separator />
                
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Prefer Crypto Payments</p>
                    <p className="text-sm text-muted-foreground">Use ATOM/PRIV for gas fees when possible</p>
                  </div>
                  <Switch 
                    checked={preferences.preferCryptoPayments}
                    onCheckedChange={(value) => updatePreference('preferCryptoPayments', value)}
                  />
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Security Tab */}
          <TabsContent value="security" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Lock className="w-5 h-5" />
                  Security Settings
                </CardTitle>
                <CardDescription>
                  Manage your account security and authentication
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-6">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Biometric Authentication</p>
                    <p className="text-sm text-muted-foreground">Use fingerprint or face recognition</p>
                  </div>
                  <Switch 
                    checked={preferences.biometricAuth}
                    onCheckedChange={(value) => updatePreference('biometricAuth', value)}
                  />
                </div>
                
                <Separator />
                
                <div className="flex items-center justify-between">
                  <div>
                    <p className="font-medium">Push Notifications</p>
                    <p className="text-sm text-muted-foreground">Receive notifications for new messages</p>
                  </div>
                  <Switch 
                    checked={preferences.notifications}
                    onCheckedChange={(value) => updatePreference('notifications', value)}
                  />
                </div>
                
                <Separator />
                
                <div className="space-y-4">
                  <h3 className="font-semibold">Cryptographic Keys</h3>
                  <div>
                    <Label>Public Key</Label>
                    <div className="flex gap-2">
                      <Input value={profile.publicKey} readOnly className="font-mono text-xs" />
                      <Button
                        variant="outline"
                        size="icon"
                        onClick={() => copyToClipboard(profile.publicKey, 'Public Key')}
                      >
                        {copied === 'Public Key' ? <Check className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                      </Button>
                    </div>
                  </div>
                  
                  <div className="flex gap-2">
                    <Button variant="outline">
                      <Download className="w-4 h-4 mr-2" />
                      Export Keys
                    </Button>
                    <Button variant="outline">
                      <QrCode className="w-4 h-4 mr-2" />
                      Show QR Code
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
            
            {/* Blockchain Status */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <BlockchainStatus />
              <GasFeeStatus />
            </div>
            
            <WalletManager />
          </TabsContent>
          
          {/* IPFS Demo Tab */}
          <TabsContent value="ipfs" className="space-y-6">
            <IPFSIntegrationDemo />
          </TabsContent>
        </Tabs>
      </div>
      
      {/* Payment View Modal */}
      {showPaymentView && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-background rounded-lg w-full max-w-4xl max-h-[90vh] overflow-auto">
            <PaymentView onBack={() => setShowPaymentView(false)} />
          </div>
        </div>
      )}
    </div>
  )
}
