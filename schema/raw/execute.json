{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Register a new .prv domain with ZK proof of ownership",
      "type": "object",
      "required": [
        "register_domain"
      ],
      "properties": {
        "register_domain": {
          "type": "object",
          "required": [
            "domain",
            "public_key",
            "zk_proof"
          ],
          "properties": {
            "domain": {
              "description": "Domain name (without .prv suffix)",
              "type": "string"
            },
            "mx_records": {
              "description": "Optional MX records for mail routing",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "public_key": {
              "description": "PGP public key for encryption",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            },
            "zk_proof": {
              "description": "ZK-SNARK proof of private key ownership",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Send an encrypted email to a .prv domain",
      "type": "object",
      "required": [
        "send_email"
      ],
      "properties": {
        "send_email": {
          "type": "object",
          "required": [
            "content_cid",
            "pow_proof",
            "recipient_domain"
          ],
          "properties": {
            "content_cid": {
              "description": "IPFS content hash of encrypted email",
              "type": "string"
            },
            "pow_proof": {
              "description": "Proof-of-work for anti-spam",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            },
            "recipient_domain": {
              "description": "Recipient domain (with .prv suffix)",
              "type": "string"
            },
            "sender_alias": {
              "description": "Optional sender alias for reply routing",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Update domain settings (only domain owner)",
      "type": "object",
      "required": [
        "update_domain"
      ],
      "properties": {
        "update_domain": {
          "type": "object",
          "required": [
            "domain"
          ],
          "properties": {
            "active": {
              "description": "Enable/disable domain",
              "type": [
                "boolean",
                "null"
              ]
            },
            "domain": {
              "type": "string"
            },
            "mx_records": {
              "description": "Updated MX records",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "public_key": {
              "description": "New PGP public key",
              "anyOf": [
                {
                  "$ref": "#/definitions/Binary"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Register as a mail relay node",
      "type": "object",
      "required": [
        "register_relay"
      ],
      "properties": {
        "register_relay": {
          "type": "object",
          "required": [
            "endpoint",
            "location",
            "stake"
          ],
          "properties": {
            "endpoint": {
              "description": "Endpoint for mail delivery",
              "type": "string"
            },
            "location": {
              "description": "Geographic location for routing optimization",
              "type": "string"
            },
            "stake": {
              "description": "Stake amount for relay reputation",
              "allOf": [
                {
                  "$ref": "#/definitions/Uint128"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Claim rewards for mail relay services",
      "type": "object",
      "required": [
        "claim_relay_rewards"
      ],
      "properties": {
        "claim_relay_rewards": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Report spam or malicious activity",
      "type": "object",
      "required": [
        "report_spam"
      ],
      "properties": {
        "report_spam": {
          "type": "object",
          "required": [
            "evidence",
            "target"
          ],
          "properties": {
            "evidence": {
              "description": "Evidence of spam/malicious behavior",
              "allOf": [
                {
                  "$ref": "#/definitions/Binary"
                }
              ]
            },
            "target": {
              "description": "Domain or content hash being reported",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
