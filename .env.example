# PrivaChain Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Cosmos Blockchain Configuration
# ===========================================
# Developer wallet mnemonic for gas sponsorship (24-word seed phrase)
DEVELOPER_MNEMONIC="your mnemonic phrase here"
VITE_DEVELOPER_MNEMONIC="your mnemonic phrase here"

# Cosmos Hub testnet configuration
COSMOS_RPC_ENDPOINT="https://rpc.theta-testnet.polypore.xyz"
COSMOS_REST_ENDPOINT="https://rest.theta-testnet.polypore.xyz:1317"
COSMOS_CHAIN_ID="theta-testnet-001"
VITE_COSMOS_RPC="https://cosmoshub-testnet.rpc.kjnodes.com"
VITE_COSMOS_LCD="https://cosmoshub-testnet.api.kjnodes.com"
VITE_COSMOS_CHAIN_ID="provider"
VITE_COSMOS_RPC_ENDPOINT="https://rpc.theta-testnet.polypore.xyz"
VITE_COSMOS_REST_ENDPOINT="https://rest.theta-testnet.polypore.xyz:1317"
VITE_COSMOS_RELAYER_MNEMONIC=""

# Test address with ATOM tokens on Cosmos Hub testnet
COSMOS_TEST_ADDRESS="cosmos1hcgd3hg6kpvsfuklsgkzjratda53vwsymrp24k"
VITE_COSMOS_TEST_ADDRESS="cosmos1hcgd3hg6kpvsfuklsgkzjratda53vwsymrp24k"

# Smart contract addresses (deployed on testnet)
VIDEO_SIGNALING_CONTRACT="cosmos1..."
VITE_VIDEO_SIGNALING_CONTRACT="cosmos1..."
QUOTA_CONTRACT_ADDR="cosmos1..."
VITE_QUOTA_CONTRACT_ADDR="cosmos1..."
VITE_PRV_REGISTRY_CONTRACT=""
VITE_PRV_OFFCHAIN_MAP_CID=""

# ===========================================
# IPFS & Filecoin Configuration
# ===========================================
# Filebase.com IPFS API credentials
FILEBASE_ACCESS_KEY="157F0935C148A8AB8A70"
FILEBASE_SECRET_KEY="fIeB3pUlpm27FRjh6novtWXa73TEKw1zKLNyWEx8"
FILEBASE_PROJECT="priva-chain"
VITE_FILEBASE_ACCESS_KEY="157F0935C148A8AB8A70"
VITE_FILEBASE_SECRET_KEY="fIeB3pUlpm27FRjh6novtWXa73TEKw1zKLNyWEx8"
VITE_FILEBASE_PROJECT="priva-chain"

# Legacy Infura IPFS API credentials (fallback)
INFURA_PROJECT_ID="your_infura_project_id"
INFURA_SECRET="your_infura_secret"
VITE_INFURA_PROJECT_ID="your_infura_project_id"
VITE_INFURA_SECRET="your_infura_secret"

# Filecoin storage API endpoints
LOTUS_API_ENDPOINT="https://api.node.glif.io"
VITE_LOTUS_API_ENDPOINT="https://api.node.glif.io"
POWERGATE_API_ENDPOINT="https://your-powergate-endpoint.com"
VITE_POWERGATE_API_ENDPOINT="https://your-powergate-endpoint.com"
FILECOIN_API_TOKEN="your_filecoin_api_token"
VITE_FILECOIN_API_TOKEN="your_filecoin_api_token"

# IPFS pinning service
PRIVACHAIN_PIN_TOKEN="your_pinning_service_token"
VITE_PRIVACHAIN_PIN_TOKEN="your_pinning_service_token"

# ===========================================
# Zero-Knowledge Proof Configuration
# ===========================================
# Paths to ZK-SNARK circuit files
ZK_CIRCUIT_WASM="/path/to/circuit.wasm"
ZK_CIRCUIT_ZKEY="/path/to/circuit_final.zkey"
ZK_VERIFICATION_KEY="/path/to/verification_key.json"
VITE_ZK_CIRCUIT_WASM="/path/to/circuit.wasm"
VITE_ZK_CIRCUIT_ZKEY="/path/to/circuit_final.zkey"
VITE_ZK_VERIFICATION_KEY="/path/to/verification_key.json"

# ===========================================
# Nym Mixnet Configuration
# ===========================================
# Nym client configuration
NYM_ENDPOINT="https://validator.nymtech.net"
NYM_CLIENT_ID="your_nym_client_id"
VITE_NYM_ENDPOINT="https://validator.nymtech.net"
VITE_NYM_CLIENT_ID="your_nym_client_id"

# ===========================================
# Payment Processing Configuration
# ===========================================
# Stripe configuration (for fiat payments)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Square configuration (for fiat payments)
SQUARE_APPLICATION_ID="sq0idp-..."
SQUARE_ACCESS_TOKEN="EAA..."
VITE_SQUARE_APPLICATION_ID="sq0idp-..."

# ===========================================
# Monitoring & Analytics Configuration
# ===========================================
# Block explorer API keys
MINTSCAN_API_KEY="your_mintscan_api_key"
BIGDIPPER_API_KEY="your_bigdipper_api_key"
VITE_MINTSCAN_API_KEY="your_mintscan_api_key"
VITE_BIGDIPPER_API_KEY="your_bigdipper_api_key"

# The Graph Protocol
GRAPH_API_KEY="your_graph_api_key"
VITE_GRAPH_API_KEY="your_graph_api_key"

# ===========================================
# Search & Indexing Configuration
# ===========================================
# Ceramic Network
CERAMIC_API_URL="https://ceramic-node.com"
VITE_CERAMIC_API_URL="https://ceramic-node.com"

# ===========================================
# TURN/STUN Server Configuration (Server-side only)
# ===========================================
# Metered.ca domain and secret for server-side API calls
METERED_DOMAIN="privachain.metered.live"
METERED_TURN_SECRET="your_metered_secret_key_here"

# Static fallback TURN servers configuration (JSON format)
TURN_STATIC_SERVERS_JSON='[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"fallback_user","credential":"fallback_credential"}]'

# ICE server caching configuration
ICE_CACHE_TTL_OFFSET_SECONDS=15
ENABLE_ICE_RATE_LIMIT=true

# Logging configuration
LOG_LEVEL=info

# ===========================================
# Development Configuration
# ===========================================
NODE_ENV="production"
VITE_NODE_ENV="production"

# Debug flags (set to "false" in production)
DEBUG_MODE="false"
VITE_DEBUG_MODE="false"